 /* Menu text should remain legible at the new global scale. */
 .item-menu-title{font-size:calc(9px * var(--ui-font-scale))!important}
 .item-menu-action{font-size:calc(9px * var(--ui-font-scale))!important;line-height:1.35!important}
+
+
+/* ===== Multi-user authentication / profile layer ===== */
+body.auth-locked .app-shell{filter:blur(1px);pointer-events:none;user-select:none}
+.auth-gate{position:fixed;inset:0;z-index:10000;display:grid;place-items:center;padding:24px;background:linear-gradient(145deg,#eef5fb 0%,#f8fbfe 55%,#e7f0f8 100%)}
+.auth-gate[hidden]{display:none!important}
+.auth-card{width:min(440px,100%);background:#fff;border:1px solid #d8e2eb;border-radius:16px;box-shadow:0 24px 70px rgba(24,56,82,.14);padding:30px}
+.auth-brand{display:flex;gap:14px;align-items:center;padding-bottom:24px;margin-bottom:24px;border-bottom:1px solid #e7edf2}
+.auth-logo{display:grid;place-items:center;width:66px;height:42px;background:#0068a8;color:#fff;font-weight:700;font-size:14px;letter-spacing:.08em;border-radius:4px}
+.auth-brand>div:last-child{display:flex;flex-direction:column;gap:3px}.auth-brand strong{font-size:16px}.auth-brand span{font-size:11px;color:#6d7b87}
+.auth-title h1{font-size:24px;margin:0 0 5px;color:#122536}.auth-title p{margin:0 0 20px;color:#667887;font-size:12px;line-height:1.55}
+.auth-form{display:flex;flex-direction:column;gap:14px}.auth-form label{display:flex;flex-direction:column;gap:6px;font-size:11px;font-weight:600;color:#405363}.auth-form label small{font-weight:400;color:#84919c}.auth-form input{height:42px;border:1px solid #cad6df;border-radius:7px;padding:0 12px;font:inherit;font-size:13px;background:#fff;color:#162936}.auth-form input:focus{outline:2px solid rgba(0,104,168,.14);border-color:#0068a8}.auth-primary{width:100%;height:42px;justify-content:center;margin-top:2px}.auth-secondary-actions{display:flex;justify-content:space-between;align-items:center}.auth-secondary-actions .text-btn{font-size:11px}
+.auth-message{padding:10px 12px;border-radius:6px;background:#eef5fb;color:#31566f;font-size:11px;line-height:1.5;border:1px solid #d7e6f1}.auth-message[data-type="error"]{background:#fff1f1;color:#9d2525;border-color:#f0caca}.auth-message[data-type="warning"]{background:#fff8e8;color:#76591e;border-color:#eedda9}.auth-message[data-type="success"]{background:#edf8f1;color:#22653d;border-color:#cce8d7}.auth-message[hidden]{display:none!important}
+.auth-setup-help{padding:14px;border:1px solid #dbe5ed;background:#f6f9fc;border-radius:8px;font-size:12px;line-height:1.55}.auth-setup-help p{margin:5px 0 0;color:#657682}.auth-setup-help code{font-size:11px}
+.account-setting-status{display:flex;flex-direction:column;gap:2px;padding:8px 12px;margin:0 4px 4px;background:#f6f9fb;border-radius:6px}.account-setting-status span{font-size:9px;text-transform:uppercase;letter-spacing:.06em;color:#82909b}.account-setting-status strong{max-width:250px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:10px;color:#40515f}
+.profile-body{display:flex;flex-direction:column;gap:14px}.profile-summary{display:flex;gap:12px;align-items:center;padding:13px;border:1px solid #e0e8ee;background:#f8fafc;border-radius:8px}.profile-summary>div:last-child{display:flex;flex-direction:column;gap:3px;min-width:0}.profile-summary strong{font-size:13px;overflow:hidden;text-overflow:ellipsis}.profile-summary small{color:#71808c;font-size:10px}.profile-avatar{display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:#0068a8;color:#fff;font-weight:600;font-size:13px;flex:0 0 auto}.profile-body .field small{display:block;margin-top:4px;color:#7d8a95;font-size:9px;line-height:1.4}.profile-storage-card{display:grid;grid-template-columns:auto 1fr;gap:3px 10px;align-items:center;padding:12px 14px;border:1px solid #d8e6ef;background:#f2f8fc;border-radius:8px}.profile-storage-card>span{grid-row:1/3;font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:#6e8291}.profile-storage-card strong{font-size:12px;color:#1d506f}.profile-storage-card small{grid-column:2;color:#6f7f8b;font-size:9px}
