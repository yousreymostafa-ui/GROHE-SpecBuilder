+}
+function pdfKitTransferPayload(){
+  if(!state.project)return null;
+  const items=(state.project.items||[]).map(item=>item.type==='section'
+    ?{id:item.id,type:'separator',name:item.title||'Break'}
+    :{id:item.id,type:'file',name:item.sku,sku:item.sku,description:getProduct(item.sku)?.description||'',auto:!!item.auto,qty:item.qty||1}
+  );
+  return {version:'12.11.1',source:'GROHE SpecBuilder',projectName:state.project.name||'Project',customer:state.project.customer||'',selectionName:activeSelectionOption()?.name||'Selection',items};
+}
+function openPdfKitPro(){
+  const payload=pdfKitTransferPayload();
+  if(!payload)return;
+  try{sessionStorage.setItem('grohe-pdfkit-transfer',JSON.stringify(payload));}catch(e){console.warn('Could not transfer selection to PDF Kit Pro',e);}
+  location.href=new URL('pdf-kit-pro/',document.baseURI).href;
+}
+function exportPdfOnly(){
+  const d=$('exportChoiceDialog');if(d?.open)d.close();
+  openPdfKitPro();
+}
+async function exportExcelAndOpenPdfKit(){
+  const d=$('exportChoiceDialog');if(d?.open)d.close();
+  await exportExcel();
+  openPdfKitPro();
+}
 
